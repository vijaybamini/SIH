VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# AI_backend (FastAPI) base URL. Defaults to http://localhost:8000 for local
# dev if unset -- only needed to point the buyer dashboard at a deployed
# backend (e.g. the Render URL) for staging/production builds.
VITE_AI_BACKEND_URL=https://sih-3rdz.onrender.com/

# --- AI_backend only, for the custom email-OTP login (email_otp.py) ---
# Supabase dashboard -> Settings -> API -> "service_role" secret. Bypasses
# all row-level security -- never commit this, never use it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# resend.com -> API Keys -> Create API Key (free tier, no card needed).
RESEND_API_KEY=re_your_resend_key
# Optional: defaults to onboarding@resend.dev (works immediately, no domain
# setup). Only set this once you've verified your own sending domain on Resend.
# RESEND_FROM_EMAIL=FarmDirect <login@yourdomain.com>
