def run_experiment(name, X_train, y_train, X_val, y_val, X_test, y_test, X_test_real, y_test_real,
                    feature_cols, cat_idx, model=None, log_target=False, sample_weight=None):
    print(f"\n{'='*70}\nEXPERIMENT: {name}\n{'='*70}")
    if model is None:
        model = HistGradientBoostingRegressor(
            max_iter=300, learning_rate=0.08, max_depth=8, categorical_features=cat_idx,
            random_state=RANDOM_STATE, early_stopping=True, validation_fraction=0.1)
    y_fit = np.log1p(y_train) if log_target else y_train
    model.fit(X_train, y_fit, sample_weight=sample_weight)

    m_train, _ = evaluate(model, X_train, y_train, f"{name} | Train", log_target)
    m_val, _ = evaluate(model, X_val, y_val, f"{name} | Validation", log_target)
    m_test, pred_test = evaluate(model, X_test, y_test, f"{name} | Test", log_target)
    m_test_real, _ = evaluate(model, X_test_real, y_test_real, f"{name} | Test (REAL only)", log_target)

    return {
        "name": name, "model": model, "feature_cols": feature_cols, "log_target": log_target,
        "metrics": {"train": m_train, "val": m_val, "test": m_test, "test_real_only": m_test_real},
        "test_pred": pred_test, "X_val": X_val, "y_val": y_val,
    }


def choose_best(experiments):
    """Section 9/14: selection is by VALIDATION MAE (never by test), and once
    selected we report — but do not re-select based on — test performance.
    Primary tie-breaker per Section 14 is MAE, then MAPE, then RMSE, then R2."""
    return min(experiments, key=lambda e: (e["metrics"]["val"]["MAE"],))


# ------------------------------------------------------------------------- #
# Main
# ------------------------------------------------------------------------- #

def run_all():
    print_feature_classification()

    df = load_data()
    df = audit_and_dedupe_same_day(df)
    df = df.sort_values('Price Date').reset_index(drop=True)
    df = add_calendar_features(df)
    df, price_level_feats, variability_feats, has_lag7 = add_lag_rolling_features(df)

    for c in LOW_CARD_CATS:
        df[c] = df[c].astype('category')

    # ---- Section 2: chronological split, unchanged boundaries ----
    train = df[df['Price Date'] <= TRAIN_END].copy()
    val = df[(df['Price Date'] > TRAIN_END) & (df['Price Date'] <= VAL_END)].copy()
    test = df[df['Price Date'] > VAL_END].copy()
    print(f"\nTrain/Val/Test sizes: {len(train)}, {len(val)}, {len(test)}")

    # ---- Section 1 fix: train-only fallback for lag/rolling NaNs ----
    train, val, test, commodity_median_train, global_train_median = train_only_fallback_fill(
        train, val, test, price_level_feats, variability_feats)

    # ---- Section 5: encodings, train-only, smoothed, safe fallback ----
    train, val, test, enc_maps, freq_maps, global_mean = apply_encodings(train, val, test)

    # Map the legacy A feature names onto the new pipeline's equivalent columns
    # (Lag_1 / Roll3_Mean) so "Model A" is a fair like-for-like leakage-fixed
    # baseline, BEFORE test_real is sliced off test (so the alias exists on both).
    train['Lag1_Modal_Price'] = train['Lag_1']
    val['Lag1_Modal_Price'] = val['Lag_1']
    test['Lag1_Modal_Price'] = test['Lag_1']
    train['Roll3_Modal_Price'] = train['Roll3_Mean']
    val['Roll3_Modal_Price'] = val['Roll3_Mean']
    test['Roll3_Modal_Price'] = test['Roll3_Mean']

    test_real = test[test['Source'] == 'REAL'] if 'Source' in test.columns else test

    # ---- Section 13 (optional): inverse-state-frequency sample weights ----
    sample_weight = None
    if STATE_SAMPLE_WEIGHTING:
        state_counts = train['State'].value_counts()
        weight_map = (1.0 / state_counts) * state_counts.median()
        sample_weight = train['State'].map(weight_map).values
        print("STATE_SAMPLE_WEIGHTING is ON — training rows are inverse-frequency "
              "weighted by State. This is an experimental toggle: A/B test it against "
              "STATE_SAMPLE_WEIGHTING=False using validation MAE before trusting it.")

    encoded_high_card = [c + '_TE' for c in HIGH_CARD_CATS]
    freq_high_card = [c + '_Freq' for c in HIGH_CARD_CATS]
    lag_basic = ['Lag_1'] + (['Lag_7'] if has_lag7 else [])
    lag_full = ['Lag_1', 'Lag_2', 'Lag_3'] + (['Lag_7'] if has_lag7 else []) + \
               ['Roll3_Mean', 'Roll7_Mean', 'Roll14_Mean', 'Roll7_Median', 'Roll7_Std',
                'Price_Change', 'Pct_Change', 'Trend_Slope']
    seasonal_basic = ['Month', 'DayOfYear']
    seasonal_full = ['Month', 'Quarter', 'WeekOfYear', 'DayOfYear', 'DOY_sin', 'DOY_cos']

    feature_sets = {
        "A_original_leakage_fixed": LOW_CARD_CATS + encoded_high_card + seasonal_basic +
                                     ['Lag1_Modal_Price', 'Roll3_Modal_Price'],  # kept only if these
                                                                                  # legacy names still exist
        "B_expanded_lag_features": LOW_CARD_CATS + encoded_high_card + seasonal_basic + lag_full,
        "C_plus_encoding_and_seasonal": LOW_CARD_CATS + encoded_high_card + freq_high_card +
                                          seasonal_full + lag_full,
    }
    # Map the legacy A feature names onto the new pipeline's equivalent columns
    # (Lag_1 / Roll3_Mean) so "Model A" is a fair like-for-like leakage-fixed
    # baseline rather than requiring the old column names to still exist.

    experiments = []

    def build_xy(feature_cols):
        return (train[feature_cols], train[TARGET_COL], val[feature_cols], val[TARGET_COL],
                test[feature_cols], test[TARGET_COL], test_real[feature_cols], test_real[TARGET_COL])

    # ---- Model A: original feature set, leakage fixed ----
    fcols_a = feature_sets["A_original_leakage_fixed"]
    cat_idx_a = [fcols_a.index(c) for c in LOW_CARD_CATS]
    Xtr, ytr, Xv, yv, Xte, yte, Xtr_real, ytr_real = build_xy(fcols_a)
    exp_a = run_experiment("A_original_leakage_fixed", Xtr, ytr, Xv, yv, Xte, yte, Xtr_real, ytr_real,
                            fcols_a, cat_idx_a, sample_weight=sample_weight)
    experiments.append(exp_a)

    # ---- Model B: + expanded lag/rolling features ----
    fcols_b = feature_sets["B_expanded_lag_features"]
    cat_idx_b = [fcols_b.index(c) for c in LOW_CARD_CATS]
    Xtr, ytr, Xv, yv, Xte, yte, Xtr_real, ytr_real = build_xy(fcols_b)
    exp_b = run_experiment("B_expanded_lag_features", Xtr, ytr, Xv, yv, Xte, yte, Xtr_real, ytr_real,
                            fcols_b, cat_idx_b, sample_weight=sample_weight)
    experiments.append(exp_b)

    # ---- Model C: + smoothed encoding, frequency encoding, fuller seasonal ----
    fcols_c = feature_sets["C_plus_encoding_and_seasonal"]
    cat_idx_c = [fcols_c.index(c) for c in LOW_CARD_CATS]
    Xtr, ytr, Xv, yv, Xte, yte, Xtr_real, ytr_real = build_xy(fcols_c)
    exp_c = run_experiment("C_plus_encoding_and_seasonal", Xtr, ytr, Xv, yv, Xte, yte, Xtr_real, ytr_real,
                            fcols_c, cat_idx_c, sample_weight=sample_weight)
    experiments.append(exp_c)

    # ---- Model D: log1p(target) on the best feature set so far (by val MAE) ----
    best_so_far = choose_best(experiments)
    fcols_d = best_so_far["feature_cols"]
    cat_idx_d = [fcols_d.index(c) for c in LOW_CARD_CATS]
    Xtr, ytr, Xv, yv, Xte, yte, Xtr_real, ytr_real = build_xy(fcols_d)
    exp_d = run_experiment(f"D_log_target_on_{best_so_far['name']}", Xtr, ytr, Xv, yv, Xte, yte,
                            Xtr_real, ytr_real, fcols_d, cat_idx_d, log_target=True, sample_weight=sample_weight)
    experiments.append(exp_d)

    # ---- Hyperparameter tuning of HistGB on the best feature set (val-only selection) ----
    best_so_far = choose_best(experiments)
    fcols_best = best_so_far["feature_cols"]
    cat_idx_best = [fcols_best.index(c) for c in LOW_CARD_CATS]
    Xtr, ytr, Xv, yv, Xte, yte, Xtr_real, ytr_real = build_xy(fcols_best)
    tuned_model, tuned_params = tune_histgb_on_validation(Xtr, ytr, Xv, yv, cat_idx_best, sample_weight)
    exp_tuned = run_experiment(f"D2_tuned_HistGB_on_{best_so_far['name']}", Xtr, ytr, Xv, yv, Xte, yte,
                                Xtr_real, ytr_real, fcols_best, cat_idx_best,
                                model=HistGradientBoostingRegressor(
                                    categorical_features=cat_idx_best, random_state=RANDOM_STATE,
                                    early_stopping=True, validation_fraction=0.1, **tuned_params),
                                sample_weight=sample_weight)
    experiments.append(exp_tuned)

    # ---- Model E: alternative model families on the best feature set ----
    best_so_far = choose_best(experiments)
    fcols_e = best_so_far["feature_cols"]
    cat_idx_e = [fcols_e.index(c) for c in LOW_CARD_CATS]
    Xtr, ytr, Xv, yv, Xte, yte, Xtr_real, ytr_real = build_xy(fcols_e)
    for mname, factory in candidate_models().items():
        if mname == "HistGB":
            continue  # already covered by the tuned variant above
        est = factory(cat_idx_e if mname in ("HistGB",) else None)
        # tree ensembles other than HistGB can't take raw pandas 'category' dtype /
        # categorical_features the same way — one-hot the low-card cats for those.
        if mname in ("RandomForest", "ExtraTrees", "XGBoost", "LightGBM"):
            Xtr_oh = pd.get_dummies(Xtr, columns=[c for c in LOW_CARD_CATS if c in Xtr.columns])
            Xv_oh = pd.get_dummies(Xv, columns=[c for c in LOW_CARD_CATS if c in Xv.columns]).reindex(columns=Xtr_oh.columns, fill_value=0)
            Xte_oh = pd.get_dummies(Xte, columns=[c for c in LOW_CARD_CATS if c in Xte.columns]).reindex(columns=Xtr_oh.columns, fill_value=0)
            Xter_oh = pd.get_dummies(Xtr_real, columns=[c for c in LOW_CARD_CATS if c in Xtr_real.columns]).reindex(columns=Xtr_oh.columns, fill_value=0)
            exp = run_experiment(f"E_{mname}", Xtr_oh, ytr, Xv_oh, yv, Xte_oh, yte, Xter_oh, ytr_real,
                                  list(Xtr_oh.columns), None, model=est, sample_weight=sample_weight)
        else:
            exp = run_experiment(f"E_{mname}", Xtr, ytr, Xv, yv, Xte, yte, Xtr_real, ytr_real,
                                  fcols_e, cat_idx_e, model=est, sample_weight=sample_weight)
        experiments.append(exp)

    # ---- Final selection: by VALIDATION MAE, never by test (Section 9/14) ----
    winner = choose_best(experiments)
    print(f"\n{'='*70}\nWINNER (selected by validation MAE): {winner['name']}\n{'='*70}")

    # ---- Old vs New comparison (Section 16.12) ----
    OLD_TEST = {"MAE": 583.0, "RMSE": 1479.0, "R2": 0.720, "MAPE_%": 19.44}
    new_test = winner["metrics"]["test"]
    improved = new_test["MAE"] < OLD_TEST["MAE"] and new_test["MAPE_%"] < OLD_TEST["MAPE_%"]
    print(f"\nOLD test:  MAE={OLD_TEST['MAE']:.1f}  RMSE={OLD_TEST['RMSE']:.1f}  R2={OLD_TEST['R2']:.4f}  MAPE={OLD_TEST['MAPE_%']:.2f}%")
    print(f"NEW test:  MAE={new_test['MAE']:.1f}  RMSE={new_test['RMSE']:.1f}  R2={new_test['R2']:.4f}  MAPE={new_test['MAPE_%']:.2f}%")
    print(f"VERDICT: {'IMPROVED' if improved else 'NOT IMPROVED — keep investigating or revert to the old model'} "
          f"(judged on test MAE and MAPE, per Section 14's priority order, not on R2 alone)")

    # ---- Price-range breakdown (Section 10) ----
    thresholds, q = price_range_thresholds(train)
    print(f"\nPrice-range thresholds (from TRAIN quantiles): Q1={q[0]:.0f}  median={q[1]:.0f}  Q3={q[2]:.0f}")
    range_table = price_range_breakdown(winner_test_y := test[TARGET_COL],
                                          winner["test_pred"] if not winner["log_target"] else winner["test_pred"],
                                          thresholds)
    print("\n--- Test performance by price range ---")
    print(range_table.to_string(index=False))
    range_table.to_csv(OUTPUT_DIR / "price_range_breakdown.csv", index=False)

    # ---- State / Commodity / Grade breakdown (Section 11) ----
    state_table = group_breakdown(test, test[TARGET_COL], winner["test_pred"], "State")
    commodity_table = group_breakdown(test, test[TARGET_COL], winner["test_pred"], "Commodity")
    grade_table = group_breakdown(test, test[TARGET_COL], winner["test_pred"], "Grade")
    print("\n--- Test performance by State (n>=30, worst first) ---")
    print(state_table.to_string(index=False))
    print("\n--- Test performance by Commodity (n>=30, worst first) ---")
    print(commodity_table.to_string(index=False))
    state_table.to_csv(OUTPUT_DIR / "state_breakdown.csv", index=False)
    commodity_table.to_csv(OUTPUT_DIR / "commodity_breakdown.csv", index=False)
    grade_table.to_csv(OUTPUT_DIR / "grade_breakdown.csv", index=False)

    # ---- Plots ----
    plot_actual_vs_predicted(test[TARGET_COL], winner["test_pred"],
                              "Actual vs Predicted (Test period, Jul-Aug 2025) — v2",
                              OUTPUT_DIR / "actual_vs_predicted.png")
    plot_error_distribution(test[TARGET_COL], winner["test_pred"],
                             "Prediction error distribution (Test) — v2",
                             OUTPUT_DIR / "error_distribution.png")

    # ---- Feature importance (permutation, on validation, same as v1) ----
    # Use the exact X_val the winner was fit/evaluated against (important for
    # one-hot-encoded alternative models, where `val[winner['feature_cols']]`
    # wouldn't line up with the original, non-one-hot columns in `val`).
    Xv_final, yv_final = winner["X_val"], winner["y_val"]
    sample = Xv_final.sample(min(20000, len(Xv_final)), random_state=1)
    sample_y = yv_final.loc[sample.index]
    pi = permutation_importance(winner["model"], sample, sample_y, n_repeats=3, random_state=1, n_jobs=-1)
    imp = pd.DataFrame({"feature": winner["feature_cols"], "importance": pi.importances_mean}) \
        .sort_values("importance", ascending=False)
    imp.to_csv(OUTPUT_DIR / "feature_importance.csv", index=False)
    plot_feature_importance(imp, f"Feature importance — {winner['name']}",
                             OUTPUT_DIR / "feature_importance.png")
    print("\n--- Feature importance (winner) ---")
    print(imp.to_string(index=False))

    # ---- Save everything ----
    all_metrics = {e["name"]: e["metrics"] for e in experiments}
    all_metrics["_winner"] = winner["name"]
    all_metrics["_old_vs_new_test"] = {"old": OLD_TEST, "new": new_test, "improved": bool(improved)}
    with open(OUTPUT_DIR / "metrics.json", "w") as f:
        json.dump(all_metrics, f, indent=2)

    joblib.dump({
        "model": winner["model"], "encoding_maps": enc_maps, "freq_maps": freq_maps,
        "global_mean": global_mean, "feature_cols": winner["feature_cols"],
        "low_card_cats": LOW_CARD_CATS, "high_card_cats": HIGH_CARD_CATS,
        "commodity_median_train": commodity_median_train, "global_train_median": global_train_median,
        "log_target": winner["log_target"], "price_range_thresholds": thresholds,
    }, OUTPUT_DIR / "mandi_price_model.joblib")

    print(f"\nAll outputs written to {OUTPUT_DIR}/. Done.")
    return experiments, winner


if __name__ == "__main__":
    run_all()
