def candidate_models():
    """Returns {name: (estimator_factory, needs_cat_idx)}. estimator_factory
    takes a `cat_idx` (indices of native-categorical columns, or None) and
    returns an unfit estimator."""
    models = {
        "HistGB": lambda cat_idx: HistGradientBoostingRegressor(
            max_iter=300, learning_rate=0.08, max_depth=8, categorical_features=cat_idx,
            random_state=RANDOM_STATE, early_stopping=True, validation_fraction=0.1),
        "RandomForest": lambda cat_idx: RandomForestRegressor(
            n_estimators=300, max_depth=16, min_samples_leaf=5, n_jobs=-1, random_state=RANDOM_STATE),
        "ExtraTrees": lambda cat_idx: ExtraTreesRegressor(
            n_estimators=300, max_depth=16, min_samples_leaf=5, n_jobs=-1, random_state=RANDOM_STATE),
    }
    if HAS_XGB:
        models["XGBoost"] = lambda cat_idx: XGBRegressor(
            n_estimators=400, learning_rate=0.06, max_depth=8, subsample=0.8,
            colsample_bytree=0.8, random_state=RANDOM_STATE, n_jobs=-1)
    else:
        print("XGBoost not installed in this environment — skipped (would be tried if available).")
    if HAS_LGBM:
        models["LightGBM"] = lambda cat_idx: LGBMRegressor(
            n_estimators=400, learning_rate=0.06, max_depth=8, random_state=RANDOM_STATE, n_jobs=-1)
    else:
        print("LightGBM not installed in this environment — skipped (would be tried if available).")
    if HAS_CATBOOST:
        models["CatBoost"] = lambda cat_idx: CatBoostRegressor(
            iterations=400, learning_rate=0.06, depth=8, random_state=RANDOM_STATE, verbose=False)
    else:
        print("CatBoost not installed in this environment — skipped (would be tried if available). "
              "CatBoost is particularly worth testing for this dataset given the heavy categorical "
              "content (District/Market/Commodity/Variety) — it natively handles high-cardinality "
              "categoricals without needing target encoding at all, which is worth a direct A/B test.")
    return models


HISTGB_GRID = [
    dict(max_iter=300, learning_rate=0.08, max_depth=8, min_samples_leaf=20, l2_regularization=0.0),
    dict(max_iter=300, learning_rate=0.05, max_depth=6, min_samples_leaf=30, l2_regularization=1.0),
    dict(max_iter=500, learning_rate=0.03, max_depth=6, min_samples_leaf=50, l2_regularization=1.0),
    dict(max_iter=500, learning_rate=0.05, max_depth=10, min_samples_leaf=20, l2_regularization=0.5),
]


def tune_histgb_on_validation(X_train, y_train, X_val, y_val, cat_idx, sample_weight=None):
    """Section 9: tune using the chronological VALIDATION set only. Test set is
    never touched here."""
    best_val_mae, best_params, best_model = np.inf, None, None
    print("\n--- Hyperparameter search (selected by VALIDATION MAE only) ---")
    for params in HISTGB_GRID:
        model = HistGradientBoostingRegressor(
            categorical_features=cat_idx, random_state=RANDOM_STATE,
            early_stopping=True, validation_fraction=0.1, **params)
        model.fit(X_train, y_train, sample_weight=sample_weight)
        pred_val = model.predict(X_val)
        val_mae = mean_absolute_error(y_val, pred_val)
        print(f"  {params} -> val MAE={val_mae:.1f}")
        if val_mae < best_val_mae:
            best_val_mae, best_params, best_model = val_mae, params, model
    print(f"Best by validation MAE: {best_params} (val MAE={best_val_mae:.1f})")
    return best_model, best_params


