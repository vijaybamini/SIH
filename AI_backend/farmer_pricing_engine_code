def load_data():
    print("Loading data...")
    df = pd.read_csv(DATA_PATH, low_memory=False)
    for p in EXTRA_REAL_DATA_PATHS:
        extra = pd.read_csv(p, low_memory=False)
        assert 'Source' in extra.columns and (extra['Source'] == 'REAL').all(), (
            f"{p} must tag every row Source='REAL' — refusing to silently merge unlabeled or synthetic data.")
        df = pd.concat([df, extra], ignore_index=True)
        print(f"  merged {len(extra)} additional REAL rows from {p}")
    df['Price Date'] = pd.to_datetime(df['Price Date'], format='%d %b %Y')
    return df


def audit_and_dedupe_same_day(df):
    """Section 1, finding #2: collapse any (group, date) duplicates to one row
    (mean Modal Price) BEFORE computing lag/rolling features, so shift/rolling
    by row-position can never blend two same-day reports into each other."""
    dup_mask = df.duplicated(subset=GROUP_COLS + ['Price Date'], keep=False)
    n_dup = int(dup_mask.sum())
    if n_dup > 0:
        print(f"WARNING: {n_dup} rows share a duplicate (group, Price Date) key. "
              f"Aggregating to one row per (group, date) — mean of {TARGET_COL} — "
              f"before computing any lag/rolling feature.")
        agg = {TARGET_COL: 'mean'}
        other_cols = [c for c in df.columns if c not in GROUP_COLS + ['Price Date', TARGET_COL]]
        for c in other_cols:
            agg[c] = 'first'
        df = df.groupby(GROUP_COLS + ['Price Date'], as_index=False).agg(agg)
    else:
        print("No duplicate (group, date) rows found — no same-day blending risk.")
    return df


# ------------------------------------------------------------------------- #
# SECTION 4 — seasonal / calendar features
# ------------------------------------------------------------------------- #

def add_calendar_features(df):
    df['Month'] = df['Price Date'].dt.month
    df['Quarter'] = df['Price Date'].dt.quarter
    df['WeekOfYear'] = df['Price Date'].dt.isocalendar().week.astype(int)
    df['DayOfYear'] = df['Price Date'].dt.dayofyear
    df['DOY_sin'] = np.sin(2 * np.pi * df['DayOfYear'] / 365.25)
    df['DOY_cos'] = np.cos(2 * np.pi * df['DayOfYear'] / 365.25)
    # 'Season' is assumed to already exist in the source data (Kharif/Rabi/Zaid-style
    # label) as it did in v1 — a deterministic function of the date, kept as-is.
    return df


# ------------------------------------------------------------------------- #
# SECTION 3 — expanded, leakage-safe lag/rolling features
# ------------------------------------------------------------------------- #

def _rolling_slope(arr):
    """Linear-regression slope of a short window of shifted (already-past) prices.
    NaN-safe; returns NaN if fewer than 2 valid points."""
    s = pd.Series(arr).dropna()
    if len(s) < 2:
        return np.nan
    x = np.arange(len(s))
    return np.polyfit(x, s.values, 1)[0]


def add_lag_rolling_features(df):
    df = df.sort_values(GROUP_COLS + ['Price Date']).reset_index(drop=True)

    obs_per_group = df.groupby(GROUP_COLS).size()
    median_obs = obs_per_group.median()
    print(f"Median observations per (State,District,Market,Commodity,Variety,Grade) group: {median_obs:.0f}")

    grp_target = df.groupby(GROUP_COLS)[TARGET_COL]
    df['Lag_1'] = grp_target.shift(1)
    df['Lag_2'] = grp_target.shift(2)
    df['Lag_3'] = grp_target.shift(3)
    if median_obs >= 10:
        df['Lag_7'] = grp_target.shift(7)
        has_lag7 = True
    else:
        print("Skipping Lag_7 — typical group history is too short to support a 7-lag feature.")
        has_lag7 = False

    # Everything below is computed on the ALREADY-SHIFTED series, per the brief's
    # explicit instruction ("shift(1).rolling(...)") — the current row's own
    # target is never part of its own rolling window.
    df['_shifted'] = grp_target.shift(1)
    grp_shifted = df.groupby(GROUP_COLS)['_shifted']

    df['Roll3_Mean'] = grp_shifted.transform(lambda s: s.rolling(3, min_periods=1).mean())
    df['Roll7_Mean'] = grp_shifted.transform(lambda s: s.rolling(7, min_periods=2).mean())
    df['Roll14_Mean'] = grp_shifted.transform(lambda s: s.rolling(14, min_periods=3).mean())
    df['Roll7_Median'] = grp_shifted.transform(lambda s: s.rolling(7, min_periods=2).median())
    df['Roll7_Std'] = grp_shifted.transform(lambda s: s.rolling(7, min_periods=2).std())

    df['Price_Change'] = df['Lag_1'] - df['Lag_2']
    df['Pct_Change'] = (df['Lag_1'] - df['Lag_2']) / df['Lag_2'].replace(0, np.nan)
    df['Trend_Slope'] = grp_shifted.transform(
        lambda s: s.rolling(5, min_periods=2).apply(_rolling_slope, raw=True))

    df = df.drop(columns=['_shifted'])

    price_level_feats = ['Lag_1', 'Lag_2', 'Lag_3'] + (['Lag_7'] if has_lag7 else []) + \
                         ['Roll3_Mean', 'Roll7_Mean', 'Roll14_Mean', 'Roll7_Median']
    variability_feats = ['Roll7_Std', 'Price_Change', 'Pct_Change', 'Trend_Slope']

    return df, price_level_feats, variability_feats, has_lag7


def train_only_fallback_fill(train, val, test, price_level_feats, variability_feats):
    """Section 1 fix: any remaining NaN (first occurrence of a group, or too-short
    history) is filled using a map computed from TRAIN ROWS ONLY. Price-level
    features (Lag_*, Roll*_Mean/Median) fall back to that commodity's TRAIN median
    price. Variability features (Roll*_Std, Price_Change, Pct_Change, Trend_Slope)
    fall back to 0 (no known change/volatility), NOT a price-level number — filling
    a standard-deviation or a percent-change column with a raw price would be a
    units bug, not just an imprecise guess."""
    commodity_median_train = train.groupby('Commodity')[TARGET_COL].median()
    global_train_median = train[TARGET_COL].median()

    for part in (train, val, test):
        fallback = part['Commodity'].map(commodity_median_train).fillna(global_train_median)
        for c in price_level_feats:
            part[c] = part[c].fillna(fallback)
        for c in variability_feats:
            part[c] = part[c].fillna(0.0)
    return train, val, test, commodity_median_train, global_train_median


# ------------------------------------------------------------------------- #
# SECTION 5 — categorical encoding (train-only, smoothed, safe fallback)
# ------------------------------------------------------------------------- #

def fit_target_encoding(train, col, smoothing=TE_SMOOTHING):
    stats = train.groupby(col)[TARGET_COL].agg(['mean', 'count'])
    global_mean = train[TARGET_COL].mean()
    smoothed = (stats['count'] * stats['mean'] + smoothing * global_mean) / (stats['count'] + smoothing)
    return smoothed, global_mean


def apply_encodings(train, val, test):
    """Target encoding (shrinkage-smoothed, train-only fit) + frequency encoding
    (train-only fit) for every high-cardinality categorical. Grade/State/Season
    stay as native categorical columns for the tree models — NEVER ordinally
    ranked (Section 5's explicit requirement)."""
    enc_maps, freq_maps = {}, {}
    global_mean = train[TARGET_COL].mean()
    for c in HIGH_CARD_CATS:
        smoothed_map, _ = fit_target_encoding(train, c)
        enc_maps[c] = smoothed_map
        freq_map = train[c].value_counts(normalize=True)
        freq_maps[c] = freq_map
        for part in (train, val, test):
            part[c + '_TE'] = part[c].map(smoothed_map).fillna(global_mean)
            part[c + '_Freq'] = part[c].map(freq_map).fillna(0.0)

    for c in LOW_CARD_CATS:
        # Fit categories on TRAIN so val/test share the same category set; unseen
        # values become a real "Unknown" category rather than silently erroring
        # or being coerced into an arbitrary numeric code.
        cats = pd.Categorical(train[c]).categories
        for part in (train, val, test):
            part[c] = pd.Categorical(part[c], categories=list(cats) + ['__unseen__']).fillna('__unseen__')
            part[c] = part[c].astype('category')

    return train, val, test, enc_maps, freq_maps, global_mean


# ------------------------------------------------------------------------- #
# Metrics
# ------------------------------------------------------------------------- #

def compute_metrics(y_true, y_pred):
    mae = mean_absolute_error(y_true, y_pred)
    rmse = mean_squared_error(y_true, y_pred) ** 0.5
    r2 = r2_score(y_true, y_pred)
    mape = np.mean(np.abs((y_true - y_pred) / y_true.replace(0, np.nan))) * 100
    return {"MAE": float(mae), "RMSE": float(rmse), "R2": float(r2), "MAPE_%": float(mape), "n": int(len(y_true))}


def evaluate(model, X, y, name, log_target=False, print_it=True):
    pred = model.predict(X)
    if log_target:
        pred = np.expm1(pred)
    m = compute_metrics(y, pred)
    if print_it:
        print(f"{name}: MAE={m['MAE']:.1f}  RMSE={m['RMSE']:.1f}  R2={m['R2']:.4f}  MAPE={m['MAPE_%']:.2f}%  (n={m['n']})")
    return m, pred


# ------------------------------------------------------------------------- #
# SECTION 10 — price-range breakdown (thresholds from TRAIN target quantiles,
# fixed BEFORE looking at val/test — not data-snooped from the evaluation set)
# ------------------------------------------------------------------------- #

def price_range_thresholds(train):
    q = train[TARGET_COL].quantile([0.25, 0.5, 0.75]).values
    return {"Low (<Q1)": (-np.inf, q[0]), "Medium (Q1-median)": (q[0], q[1]),
            "High (median-Q3)": (q[1], q[2]), "Very High (>Q3)": (q[2], np.inf)}, q


def price_range_breakdown(y_true, y_pred, thresholds):
    rows = []
    for label, (lo, hi) in thresholds.items():
        mask = (y_true > lo) & (y_true <= hi) if hi != np.inf else (y_true > lo)
        if mask.sum() == 0:
            continue
        m = compute_metrics(y_true[mask], y_pred[mask])
        m["range"] = label
        rows.append(m)
    return pd.DataFrame(rows)[["range", "n", "MAE", "RMSE", "R2", "MAPE_%"]]


# ------------------------------------------------------------------------- #
# SECTION 11 — state / commodity / grade breakdown (min-n gated, nothing hidden)
# ------------------------------------------------------------------------- #

def group_breakdown(df_eval, y_true, y_pred, group_col, min_n=30):
    tmp = df_eval[[group_col]].copy()
    tmp['_y'] = y_true.values
    tmp['_pred'] = y_pred
    rows = []
    for key, g in tmp.groupby(group_col, observed=True):
        if len(g) < min_n:
            continue
        m = compute_metrics(g['_y'], g['_pred'])
        m[group_col] = key
        rows.append(m)
    out = pd.DataFrame(rows)
    if len(out) == 0:
        return out
    return out[[group_col, "n", "MAE", "RMSE", "R2", "MAPE_%"]].sort_values("MAPE_%", ascending=False)


